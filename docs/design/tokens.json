{
  "$name": "أقوَم — Design Tokens",
  "$version": "1.0.0",
  "$themes": ["light", "dark"],
  "$themeNames": { "light": "Golden Calm", "dark": "Moonlight" },

  "color": {
    "background":       { "light": "#FBF5E3", "dark": "#0E1626", "desc": "app canvas" },
    "surface":          { "light": "#FFFBEF", "dark": "#151F33", "desc": "cards, sheets, bars" },
    "surfaceVariant":   { "light": "#F5EDD6", "dark": "#1E2A44", "desc": "insets, chips, fills" },
    "primary":          { "light": "#8A6400", "dark": "#E8CF8A", "desc": "primary ink and fills" },
    "primaryContainer": { "light": "#F0E4BE", "dark": "#303A4C", "desc": "tinted container (dark = primary 16% over surfaceVariant)" },
    "accentGold":       { "light": "#D4A72C", "dark": "#9DB4D9", "desc": "ornament accent; moon silver-blue in dark" },
    "text":             { "light": "#2B2418", "dark": "#EDE6D3", "desc": "primary text" },
    "textSecondary":    { "light": "#6E6451", "dark": "#A9A491", "desc": "secondary text" },
    "divider":          { "light": "#E8DDC5", "dark": "#2A3550", "desc": "hairlines, borders, tracks" },
    "success":          { "light": "#5F7C3A", "dark": "#8FB36B", "desc": "completion states" },

    "onPrimary":        { "light": "#FFFCF2", "dark": "#1A1405", "desc": "ink on a primary fill" },
    "onHero":           { "light": "#FFFCF2", "dark": "#EDE6D3", "desc": "text on the hero card" },
    "onHeroMuted":      { "light": "#FFFCF2", "dark": "#A9A491", "desc": "secondary text on the hero card" },
    "onHeroCount":      { "light": "#FFFCF2", "dark": "#E8CF8A", "desc": "the hero countdown" },
    "heroStart":        { "light": "#7A5900", "dark": "#20304A", "desc": "hero gradient start" },
    "heroEnd":          { "light": "#5A4200", "dark": "#18233A", "desc": "hero gradient end" },

    "ornamentBlue":     { "light": "#1B3A8B", "dark": "#7E9BC4", "desc": "lapis illumination; moon-toned in dark" },
    "ornamentLine":     { "light": "#B08A22", "dark": "#9A8A55", "desc": "gold rules of the page frame" },

    "successInk":       { "light": "#4C6434", "dark": "#8FB36B", "desc": "success used as small text" },
    "primaryInk":       { "light": "#6B5214", "dark": "#E9D59E", "desc": "primary used as text on primaryContainer" },

    "pageInk":          { "light": "#FFFCF2", "dark": "#EDE6D3", "desc": "presentation chrome text (outside the device)" },
    "pageBg":           { "light": "#151009", "dark": "#0A101D", "desc": "presentation stage background" }
  },

  "system": {
    "$desc": "Android system surfaces — NOT app tokens; used only for notification mockups",
    "shade": { "light": "#EFF1F5", "dark": "#0F1316" },
    "card":  { "light": "#FFFFFF", "dark": "#1E2225" },
    "text":  { "light": "#1B1C1E", "dark": "#E3E3E6" },
    "sub":   { "light": "#45474B", "dark": "#C2C6CB" },
    "chip":  { "light": "#E8EAED", "dark": "#2A2F33" },
    "lockWallpaper": { "light": "linear-gradient(165deg,#0D1117,#151A22 52%,#1B1F28)", "dark": "linear-gradient(165deg,#0D1117,#151A22 52%,#1B1F28)" }
  },

  "spacing": {
    "$scale": "8pt grid",
    "space-1": "8px",
    "space-2": "16px",
    "pageInset": "12px",
    "frameInnerLine": "13.45px",
    "textInset": "25.45px",
    "$note": "pageInset is the guaranteed gap between the ornamental frame's innermost rule and the nearest glyph; textInset = frameInnerLine + pageInset"
  },

  "radius": {
    "radius-card": "12px",
    "radius-hero": "20px",
    "radius-control": "10px",
    "widget": "28px",
    "notification": "26px",
    "device": "35px"
  },

  "size": {
    "frame": { "w": "360px", "h": "800px" },
    "touchTarget": "48px",
    "gridCell": "46px",
    "counterRing": "220px",
    "statusBar": "32px",
    "bottomNav": "64px"
  },

  "type": {
    "$fonts": {
      "ui": "Cairo",
      "quran": "Amiri Quran",
      "display": "Reem Kufi",
      "naskh": "Amiri"
    },
    "display": { "font": "Reem Kufi", "size": "20px", "weight": 600, "lineHeight": 1.2, "use": "surah cartouche" },
    "h1":      { "font": "Cairo", "size": "19px", "weight": 800, "lineHeight": 1.25, "use": "screen titles" },
    "h2":      { "font": "Cairo", "size": "16px", "weight": 800, "lineHeight": 1.3, "use": "card titles" },
    "hero":    { "font": "Cairo", "size": "29px", "weight": 800, "lineHeight": 1.1, "use": "next prayer name" },
    "count":   { "font": "Cairo", "size": "34px", "weight": 800, "lineHeight": 1, "tabular": true, "use": "live countdown" },
    "counter": { "font": "Cairo", "size": "48px", "weight": 800, "lineHeight": 1, "tabular": true, "use": "adhkar counter" },
    "title":   { "font": "Cairo", "size": "14px", "weight": 800, "lineHeight": 1.3, "use": "top bar / rows" },
    "body":    { "font": "Cairo", "size": "12.5px", "weight": 700, "lineHeight": 1.5, "use": "list rows" },
    "label":   { "font": "Cairo", "size": "11.5px", "weight": 700, "lineHeight": 1.4, "use": "controls" },
    "caption": { "font": "Cairo", "size": "10px", "weight": 600, "lineHeight": 1.5, "use": "meta, badges" },
    "nav":     { "font": "Cairo", "size": "9.5px", "weight": 800, "lineHeight": 1, "use": "bottom navigation" },
    "quran":   { "font": "Amiri Quran", "size": "26px", "weight": 400, "lineHeight": 2.0, "align": "center", "use": "mushaf text; range 24–40px" },
    "bismillah": { "font": "Amiri Quran", "size": "21.8px", "weight": 400, "lineHeight": 2.0, "align": "center" }
  },

  "elevation": {
    "card":  { "light": "0 1px 1.5px rgba(43,36,24,0.08)", "dark": "none", "$note": "dark uses tonal layers + 1px divider borders instead of shadows" },
    "hero":  { "light": "0 18px 40px -18px rgba(138,100,0,0.55)", "dark": "0 0 60px -12px rgba(232,207,138,0.30)" },
    "sheet": { "light": "0 -8px 30px -12px rgba(43,36,24,0.25)", "dark": "0 -8px 30px -12px rgba(0,0,0,0.6)" }
  },

  "motion": {
    "themeFade": "250ms ease",
    "sheet": "320ms cubic-bezier(0.22,1,0.36,1)",
    "ripple": "550ms cubic-bezier(0.22,1,0.36,1)",
    "starTurn": "44s linear infinite",
    "autoScrollMax": "104px/s (~2 lines per second)"
  },

  "opacity": {
    "geometricVeil": 0.05,
    "ornamentCorner": 0.5,
    "moonGlow": 0.18
  }
}
